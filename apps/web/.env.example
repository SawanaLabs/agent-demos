AI_GATEWAY_API_KEY=your_gateway_api_key
# Required OpenAI Platform project key for hosted openai/* model calls.
# For the Eve service, set this in its build and runtime environments.
OPENAI_API_KEY=
# Image migration demo: cloudflare (default) or vercel
IMAGE_GATEWAY=cloudflare
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v3/ai
AI_GATEWAY_CHAT_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small
DATABASE_URL=postgresql://user:password@localhost:5432/database
REDIS_URL=rediss://default:token@example.upstash.io:6379
CRON_SECRET=your_customer_memory_cleanup_secret
VERCEL_OIDC_TOKEN=your_vercel_oidc_token
# Required in Vercel Production and Preview test mode; use the Production property.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Production-only basic traffic analytics; use this site's generated script.
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.hsawana9.com/js/pa-YOUR_SITE_ID.js
# Optional explicit Preview test mode; also expose the Production ID in Preview
# so the app can fail closed unless this uses a separate GA4 test property.
# NEXT_PUBLIC_GA_PREVIEW_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional AI Gateway base URL for non-OpenAI models in the OpenAI Agents SDK demo:
# OPENAI_AGENTS_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Optional explicit model override for the OpenAI Agents SDK demo:
# OPENAI_AGENTS_MODEL=openai/gpt-5-mini
# Optional reasoning override for the OpenAI Agents SDK demo:
# OPENAI_AGENTS_REASONING_EFFORT=medium
# Alternative local auth if OIDC is unavailable:
# VERCEL_TOKEN=your_vercel_access_token
# VERCEL_TEAM_ID=your_vercel_team_id
# VERCEL_PROJECT_ID=your_vercel_project_id

# Required on Vercel: a stable random secret of at least 32 characters.
# Changing it resets free visitor identities. Never expose it to the browser.
# SITE_USAGE_VISITOR_SECRET=
